<!--roseengine_tab.jinja2 -->
<style>

</style>

<div id="roseengine_plugin_main" class="container-fluid">

    <!-- ── Rock + Pump Row ───────────────────────────────────────── -->
    <div class="row-fluid">

        <!-- ── Rock Column ──────────────────────────────────────── -->
        <div id="rock" class="span6">
            <div id="rockarea" style="height: 300px;"></div>
            <div id="rock_controls">

                <div class="re-field">
                    <label for="rock_file_select">Rock Rosette:</label>
                    <select id="rock_file_select">
                        <option value="">Loading...</option>
                    </select>
                </div>

                <div class="re-field">
                    <label title="Amplitude scale factor for rocking" for="r_amp">Rock amplitude:</label>
                    <input id="r_amp" type="number" value="1" max="10.0" step="0.1" data-bind="value: r_amp">
                </div>

                <div class="re-field" data-bind="visible: exp">
                    <label title="Radial eccentric offset, in mm" for="ecc_offset">Eccentric offset:</label>
                    <input id="ecc_offset" type="number" min="0.0" value="0" step="any" data-bind="value: ecc_offset">
                </div>

            </div>
        </div>

        <!-- ── Pump Column ──────────────────────────────────────── -->
        <div id="pump" class="span6">
            <div id="pumparea" style="height: 300px;"></div>
            <div id="pump_controls">

                <div class="re-field">
                    <label for="pump_file_select">Pump Rosette:</label>
                    <select id="pump_file_select">
                        <option value="">Loading...</option>
                    </select>
                </div>

                <div class="re-field">
                    <label title="Amplitude scale factor" for="p_amp">Pump amplitude:</label>
                    <input id="p_amp" type="number" value="0.5" max="5.0" step="any" data-bind="value: p_amp">
                </div>

                <div class="re-slider-group">
                    <label title="Phase offset — must be in intervals of angle increments" for="pump_offset">
                        Phase offset: <strong data-bind="text: pump_offset()"></strong>
                    </label>
                    <input class="slider" id="pump_offset" type="range" min="0.0" max="360.0" step="0.5"
                           data-bind="value: pump_offset, valueUpdate: 'input'">
                </div>

                <div class="re-checkbox">
                    <input id="pump_invert" type="checkbox" data-bind="checked: pump_invert">
                    <label title="Invert pumping direction" for="pump_invert">Invert pump</label>
                </div>

            </div>
        </div>

    </div>

    <!-- ── Clear Buttons Row ─────────────────────────────────────── -->
    <div class="row-fluid">
        <div class="span6 re-clear">
            <button id="clear_rock" class="btn" data-bind="click: function() {clear_rosette('rock')}">Clear</button>
        </div>
        <div class="span6 re-clear">
            <button id="clear_pump" class="btn" data-bind="click: function() {clear_rosette('pump')}">Clear</button>
        </div>
    </div>

    <hr>

    <!-- ── Periodic Wave Functions (span12) ─────────────────────── -->
    <div class="row-fluid">
        <div class="span12">
            <div class="re-panel">
                <details>
                    <summary>Periodic Wave Functions</summary>
                    <div class="geo-columns" style="margin-top: 10px;">

                        <div class="geo-col">
                            <div class="re-field">
                                <label for="wave_type">Wave function:</label>
                                <select id="wave_type" data-bind="value: wave_type">
                                    <option value="sin">Sine</option>
                                    <option value="tri">Triangle</option>
                                    <option value="square">Square</option>
                                    <option value="saw">Sawtooth</option>
                                </select>
                            </div>
                            <div class="re-field">
                                <label for="default_radius">Radius (mm):</label>
                                <input id="default_radius" type="number" value="1" step="any" data-bind="value: default_radius">
                            </div>
                            <div class="re-field">
                                <label for="s_amp">Amplitude (mm):</label>
                                <input id="s_amp" type="number" value="1" step="any" data-bind="value: s_amp">
                            </div>
                            <div class="re-field">
                                <label title="The number of complete periods per 360 degrees" for="peak">Periods:</label>
                                <input id="peak" type="number" value="1" step="1" data-bind="value: peak">
                            </div>
                        </div>

                        <div class="geo-col" style="display: flex; align-items: flex-start; gap: 8px; padding-top: 4px;">
                            <button id="create_para_rock" class="btn" data-bind="click: function() {parametric_rosette('rock')}">Create Rock</button>
                            <button id="create_para_pump" class="btn" data-bind="click: function() {parametric_rosette('pump')}">Create Pump</button>
                        </div>

                    </div>
                </details>
            </div>
        </div>
    </div>

    <!-- ── Curvilinear (span12) ──────────────────────────────────── -->
    <div class="row-fluid">
        <div class="span12">
            <div class="re-panel">
                <details>
                    <summary>Curvilinear</summary>
                    <div class="geo-columns" style="margin-top: 10px;">

                        <!-- Left col: file, direction, helical, reciprocate -->
                        <div class="geo-col">
                            <div class="re-field">
                                <label for="curve_select">SVG/DXF file:</label>
                                <select id="curve_select" data-bind=""></select>
                            </div>
                            <div class="re-field">
                                <label title="Helical rotation incremented over the length of the curvilinear pattern" for="helical">Helical rotation:</label>
                                <input id="helical" type="number" step="any" data-bind="value: helical">
                            </div>
                            <div class="re-checkbox">
                                <input id="recip" type="checkbox" checked data-bind="checked: recip">
                                <label title="Reciprocate along profile, otherwise stop at the end of profile." for="recip">Reciprocate</label>
                            </div>
                        </div>

                        <!-- Right col: feed, stepdown, retract -->
                        <div class="geo-col">
                            <div class="re-field">
                                <label for="mm_rev">mm/rev:</label>
                                <input type="number" id="mm_rev" step="any" min="0" max="200" data-bind="numeric, value: mm_rev">
                            </div>
                            <div class="re-field">
                                <label for="curve_stepdown">Step down/pass (mm):</label>
                                <input type="number" id="curve_stepdown" step="any" min="0" max="200" data-bind="numeric, value: curve_stepdown">
                            </div>
                            <div class="re-checkbox">
                                <input id="curve_retract" type="checkbox" data-bind="checked: curve_retract">
                                <label for="curve_retract">Retract on reset</label>
                            </div>
                            <div class="re-field">
                                <label for="curve_retract_extra">Extra retraction (mm):</label>
                                <input type="number" id="curve_retract_extra" step="any" min="0" max="50" data-bind="numeric, value: curve_retract_extra">
                            </div>
                        </div>

                    </div>
                </details>
            </div>
        </div>
    </div>

    <!-- ── Geometric Chuck (span12) ─────────────────────────────── -->
    <div class="row-fluid">
        <div class="span12">
            <div class="re-panel">
                <details>
                    <summary>Geometric Chuck</summary>
                    <div style="margin-top: 10px;">

                        <!-- Stage rows: full width -->
                        <!-- ko foreach: stages -->
                        <div class="geo-stage-row">
                            <label title="radius, p, q, phase">Stage <span data-bind="text: id"></span>:</label>
                            <input type="number" step="any" placeholder="radius" data-bind="value: radius">
                            <input type="number" step="any" placeholder="p"      data-bind="value: p">
                            <input type="number" step="any" placeholder="q"      data-bind="value: q">
                            <input type="number" step="any" placeholder="phase"  data-bind="value: phase">
                        </div>
                        <!-- /ko -->

                        <!-- Options below stage rows -->
                        <div class="re-field" style="margin-top: 8px;">
                            <label title="Number of sampling points" for="geo_points">Sample points:</label>
                            <input id="geo_points" type="number" min="50" step="any" data-bind="value: geo_points">
                        </div>
                        <div class="re-field">
                            <label title="Scale to fit this radius" for="target_radius">Target radius:</label>
                            <input id="target_radius" type="number" step="any" data-bind="value: target_radius">
                        </div>
                        <div class="re-field">
                            <label title="Adjust depth of cut based on radius. Positive values cut deeper at center, negative at max radius." for="radial_depth">Radial depth (mm):</label>
                            <input id="radial_depth" type="number" step="any" data-bind="value: radial_depth">
                        </div>
                        <div class="re-field">
                            <label for="saved_geo_select">Saved geometrics:</label>
                            <select id="saved_geo_select" data-bind=""></select>
                        </div>
                        <div style="margin-top: 8px; display: flex; gap: 6px; flex-wrap: wrap;">
                            <button id="create_geo" class="btn" data-bind="click: function() {create_geo(false)}">Create</button>
                            <button id="geo_random" class="btn" data-bind="click: function() {create_geo(true)}">Random</button>
                            <button id="geo_save"   class="btn" data-bind="click: function() {save_geo()}">Save Geo</button>
                            <button id="gcode_geo"  class="btn" title="Convert current geometric design to XYZ gcode, saved to the templates folder"
                                    data-bind="visible: exp, click: function() {geo_gcode()}">To Gcode</button>
                        </div>

                    </div>
                </details>
            </div>
        </div>
    </div>

    <!-- ── Running + Jog Controls ───────────────────────────────── -->
    <div id="lower" class="row-fluid">

        <!-- ── Running Column ───────────────────────────────────── -->
        <div id="running" class="span6">

            <div class="re-slider-group">
                <label title="RPM" for="rpm">
                    RPM: <strong data-bind="text: rpm()"></strong>
                </label>
                <input class="slider" id="rpm" type="range" min="0.25" max="6" step="0.25"
                       data-bind="value: rpm, valueUpdate: 'input'">
            </div>

            <div class="re-checkbox">
                <input id="forward" type="checkbox" checked data-bind="checked: forward">
                <label title="Uncheck to run spindle in reverse" for="forward">Spindle forward</label>
            </div>

            <details>
                <summary>Fixed Plane</summary>
                <div class="re-checkbox">
                    <input id="b_adjust" type="checkbox" data-bind="checked: b_adjust">
                    <label title="Modifies X and Z coordinates based on current B-axis angle" for="b_adjust">Use fixed plane based on B-angle</label>
                </div>
                <div class="re-checkbox">
                    <input id="moveb" type="checkbox" data-bind="checked: moveb, valueUpdate: 'input'">
                    <label title="Any linear injected movements are modified based on current B angle, as referenced by B-ref." for="moveb">Inject along B-angle</label>
                </div>
                <div class="re-field">
                    <label title="Reference B-angle for your cut. See special notes." for="bref">B-ref for this frame:</label>
                    <input id="bref" type="number" step="any" data-bind="value: bref">
                </div>
            </details>

            <details>
                <summary>Elliptical Chuck</summary>
                <div class="re-field">
                    <label title="Major radius of ellipse for calculation purposes. All shift values will be relative to this." for="e_rad">Nominal radius (mm):</label>
                    <input id="e_rad" type="number" value="1" step="any" data-bind="value: e_rad">
                </div>
                <div class="re-field">
                    <label title="Ratio of major to minor. Value of 1 will be a circle." for="ratio">Ratio:</label>
                    <input id="ratio" type="number" min="1.0" step="any" data-bind="value: e_ratio">
                </div>
            </details>

            <div style="margin-top: 10px;">
                <button id="start_job_button"  class="btn btn-primary" data-bind="enable: is_operational() && available(), click: startjob">Start</button>
                <button id="stop_job_button"   class="btn btn-primary" data-bind="enable: is_operational() && available(), click: stopjob">Stop</button>
                <button id="gotostart_button"  class="btn btn-primary" data-bind="enable: is_operational() && available(), click: gotostart, css: { 'needs-reset': need_reset }">Reset</button>
                <button id="clutch_button"     class="btn btn-primary" data-bind="visible: curvilinear(), enable: is_operational() && available(), click: toggle_clutch">Clutch</button>
            </div>

            <!-- Recording controls -->
            <div id="reccontrols" style="margin-top: 10px;">
                <label>Recording Controls</label>
                <div style="display: flex; gap: 6px; margin-top: 4px;">
                    <button id="recpause"  title="Start/Pause Recording"              class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {record('start')}"><i class="fa fa-play"></i></button>
                    <button id="stoprec"   title="Terminate recording and write file"  class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {record('stop')}"><i class="fa fa-save"></i></button>
                    <button id="deleterec" title="Trash current recording"             class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {record('trash')}"><i class="fa fa-trash"></i></button>
                    <button id="writemode" title="Write rosette data to a gcode file"  class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: available(), click: function() {write_mode()}"><i class="fa fa-file"></i></button>
                </div>
            </div>

        </div>

        <!-- ── Jog / Controls Column ────────────────────────────── -->
        <div id="controls" class="span6">

            <div class="re-field">
                <label title="Relative movement distance (absolute value)" for="dist">Movement distance:</label>
                <input id="dist" type="number" value="0.5" min="0" max="360" step="any" data-bind="value: dist">
            </div>

            <div style="margin-bottom: 8px;">
                <!-- ko foreach: distances -->
                <button class="btn btn-default btn-sm"
                        data-bind="click: function() { $root.distClicked($data); },
                                   css: { active: $root.dist() === $data },
                                   event: { contextmenu: function(data, event) { return $root.distRightClicked($data, event); } },
                                   text: $data">
                </button>
                <!-- /ko -->
            </div>

            <div style="margin-bottom: 8px;">
                <table id="jogger" border="0" style="margin: 0 auto;">
                    <tbody>
                    <tr>
                        <td>
                            <button class="btn box" style="visibility: hidden; width: 40px; height: 40px;"></button>
                            <button id="ctrl-zdown" class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('down')}"><i class="fa fa-arrow-up"></i></button>
                            <button class="btn box" style="visibility: hidden; width: 40px; height: 40px;"></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <button id="ctrl-xdown" class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('left')}"><i class="fa fa-arrow-left"></i></button>
                            <button id="laser"      class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: laser_mode() && is_operational(), click: function() {toggle_laser()}"><i class="fa fa-bullseye"></i></button>
                            <button id="ctrl-xup"   class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('right')}"><i class="fa fa-arrow-right"></i></button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <button id="ctrl-aplus"  title="Rotate A positive" class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('plus')}"><i class="fa fa-rotate-left"></i></button>
                            <button id="ctrl-zup"                               class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('up')}"><i class="fa fa-arrow-down"></i></button>
                            <button id="ctrl-aminus" title="Rotate A negative" class="btn box" style="border: 1px solid; width: 40px; height: 40px;" data-bind="enable: is_operational() && available(), click: function() {re_jog('minus')}"><i class="fa fa-rotate-right"></i></button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>

            <div id="laser_numbers" data-bind="visible: laser_mode()">
                <div class="re-field">
                    <label title="The base laser power, 0 to 1000" for="laser_power">Laser power:</label>
                    <input id="laser_power" type="number" max="1000" value="1" step="1" data-bind="value: laser_base">
                </div>
                <div class="re-field">
                    <label title="The target linear feed rate (mm/min) for the provided laser power, only used if power correction is on" for="laser_feed">Nominal feed:</label>
                    <input id="laser_feed" type="number" value="1" step="1" data-bind="value: laser_feed">
                </div>
            </div>

        </div>
    </div>

</div>
